#!/bin/sh

if [ "$SKIP_HOOK" = "1" ]; then
    exit 0
fi

echo "==> Validating solution compilation before push..."

dotnet build src/Orbit/Orbit.PL/Orbit.PL.csproj -c Release
if [ $? -ne 0 ]; then
    echo "ERROR: Orbit.PL build failed! Push aborted."
    exit 1
fi

dotnet build src/Orbit/Orbit.Console/Orbit.Console.csproj -c Release
if [ $? -ne 0 ]; then
    echo "ERROR: Orbit.Console build failed! Push aborted."
    exit 1
fi

echo "==> Build verification passed."
exit 0
