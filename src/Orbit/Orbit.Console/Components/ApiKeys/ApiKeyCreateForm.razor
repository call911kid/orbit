@namespace Orbit.Console.Components.ApiKeys

<div class="mb-5 bg-white border border-slate-200 border-l-[3px] border-l-[#0f766e] rounded-xl px-4 py-3 shadow-2xs">
    <form @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault>
        <div class="flex flex-wrap lg:flex-nowrap items-center gap-3">
            <div class="shrink-0 pr-2 border-r border-slate-200 hidden xl:block">
                <div class="text-[11px] font-bold text-slate-900 uppercase tracking-wide">Generate Key</div>
            </div>

            <div class="flex-1 min-w-[200px]">
                <input id="api-key-name"
                       type="text"
                       required
                       maxlength="100"
                       aria-label="Key Name"
                       placeholder="e.g. Orbit MCP Client"
                       class="w-full text-xs px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50/50 focus:bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#0f766e]"
                       @bind="keyName"
                       @bind:event="oninput" />
            </div>

            <div class="flex items-center gap-1.5 w-36 shrink-0">
                <label for="api-key-role" class="text-[11px] font-medium text-slate-400">Role</label>
                <select id="api-key-role"
                        class="w-full text-xs font-mono px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-900 focus:outline-none focus:border-[#0f766e] cursor-pointer"
                        @bind="selectedRole">
                    @foreach (var role in AvailableRoles)
                    {
                        <option @key="role" value="@role">@role</option>
                    }
                </select>
            </div>

            <div class="flex items-center gap-1.5 w-52 shrink-0">
                <label for="@(isCustomHours ? "api-key-custom-hours" : "api-key-expiry")" class="text-[11px] font-medium text-slate-400 whitespace-nowrap">Expires In</label>
                <div class="flex-1 min-w-0">
                    @if (!isCustomHours)
                    {
                        <select id="api-key-expiry"
                                value="@selectedExpiryOption"
                                @onchange="HandleExpiryOptionChanged"
                                class="w-full text-xs font-mono px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-900 focus:outline-none focus:border-[#0f766e] cursor-pointer">
                            <option value="60">1 Hour</option>
                            <option value="1440">24 Hours</option>
                            <option value="10080">7 Days</option>
                            <option value="43200">30 Days</option>
                            <option value="custom">Custom...</option>
                        </select>
                    }
                    else
                    {
                        <div class="relative flex items-center">
                            <input id="api-key-custom-hours"
                                   type="number"
                                   min="1"
                                   required
                                   placeholder="Hours..."
                                   class="w-full min-w-0 text-xs font-mono bg-white border border-slate-200 focus:border-[#0f766e] rounded-lg pl-2.5 pr-6 py-1.5 text-slate-900 placeholder-slate-400 focus:outline-none"
                                   @bind="customHours"
                                   @bind:event="oninput" />
                            <button type="button"
                                    @onclick="ResetToPresets"
                                    class="absolute right-2 text-slate-400 hover:text-slate-600 cursor-pointer text-xs leading-none"
                                    title="Reset to preset">
                                ✕
                            </button>
                        </div>
                    }
                </div>
            </div>

            <button type="submit"
                    disabled="@IsBusy"
                    class="w-full sm:w-auto px-4 py-1.5 rounded-lg bg-[#0f766e] hover:bg-[#115e59] disabled:opacity-60 text-white text-xs font-semibold transition-colors cursor-pointer shrink-0">
                @(IsBusy ? "Generating..." : "Generate")
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(validationError))
        {
            <p class="text-[11px] text-rose-600 font-medium mt-2">@validationError</p>
        }
    </form>
</div>
