@namespace Orbit.Console.Components.ApiKeys

@if (CreatedKey is not null)
{
    <div @onclick="HandleBackdropClickAsync"
         @onkeydown="HandleKeyDownAsync"
         tabindex="-1"
         class="fixed inset-0 bg-slate-900/45 backdrop-blur-xs flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl max-w-lg w-full p-5 shadow-xl border border-slate-200 animate-in fade-in zoom-in-95"
             @onclick:stopPropagation="true">
            <div class="flex items-start justify-between gap-3 mb-3">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">New API Key</h3>
                    <p class="text-[11px] font-mono text-slate-500 mt-0.5">
                        @CreatedKey.Name · @CreatedKey.Role · @ApiKeyDisplayHelper.FormatTimeLeft(CreatedKey.ExpiresAt)
                    </p>
                </div>
                <button type="button"
                        @onclick="CloseAsync"
                        class="text-slate-400 hover:text-slate-700 text-sm leading-none p-1 cursor-pointer"
                        title="Close">
                    ✕
                </button>
            </div>

            <div @onclick="CopyKeyOnlyAsync"
                 role="button"
                 tabindex="0"
                 class="group relative flex items-center justify-between gap-3 p-3 rounded-lg border transition-all cursor-pointer mb-2 @(isCopied ? "border-teal-500 bg-teal-50/40" : pulseGuard ? "border-teal-500 bg-teal-50/20 ring-2 ring-teal-500/40" : "border-slate-200 bg-slate-50 hover:border-teal-500/70 hover:bg-teal-50/20")">
                <code class="font-mono text-xs font-medium text-slate-900 break-all select-all leading-relaxed">@CreatedKey.RawKey</code>
                <span class="shrink-0 px-2.5 py-1 rounded-md border text-[11px] font-semibold transition-colors @(isCopied ? "border-teal-300 bg-teal-50 text-teal-800" : "border-slate-200 bg-white text-slate-700 group-hover:border-teal-300 group-hover:text-teal-800")">
                    @(isCopied ? "✓ Copied" : "Copy")
                </span>
            </div>

            <p class="text-[11px] text-slate-400 mb-4">Save this key now — it won't be shown again after closing.</p>

            <div class="flex items-center justify-between gap-2 pt-3 border-t border-slate-100">
                <span class="text-[11px] font-medium text-teal-700">
                    @if (isCopied)
                    {
                        <span>✓ Copied to clipboard</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(guardMessage))
                    {
                        <span>@guardMessage</span>
                    }
                </span>

                <div class="flex items-center gap-2">
                    <button type="button"
                            @onclick="CloseAsync"
                            class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-colors cursor-pointer">
                        Close
                    </button>
                    <button type="button"
                            @onclick="HandlePrimaryActionAsync"
                            class="px-4 py-1.5 rounded-lg bg-[#0f766e] hover:bg-[#115e59] text-white text-xs font-semibold shadow-2xs transition-colors cursor-pointer">
                        @(isCopied ? "Done" : "Copy & Close")
                    </button>
                </div>
            </div>
        </div>
    </div>
}
