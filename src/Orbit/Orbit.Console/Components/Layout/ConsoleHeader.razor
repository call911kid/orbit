@namespace Orbit.Console.Components.Layout

<header class="bg-white px-5 py-3 border-b border-slate-200 flex items-center justify-between">
    <div class="flex items-center gap-4">
        <a href="@ConsoleUrls.Channels" class="flex items-center gap-2 no-underline">
            <span class="w-2.5 h-2.5 rounded-full bg-[#0f766e]"></span>
            <span class="font-bold text-sm tracking-wide text-slate-900">ORBIT</span>
        </a>
        <nav aria-label="Console Sections" class="flex bg-slate-100 p-0.5 rounded-lg border border-slate-200 text-xs font-semibold">
            @foreach (var tab in NavTabs)
            {
                <a @key="tab.Href"
                   href="@tab.Href"
                   class="px-3 py-1 rounded-md transition-all cursor-pointer no-underline @(tab.Matches(CurrentPath) ? "bg-white text-slate-900 shadow-xs" : "text-slate-500 hover:text-slate-700")">
                    @tab.Title (@tab.GetCount(State))
                </a>
            }
        </nav>
    </div>

    <div class="flex items-center gap-2">
        <button type="button" 
                class="text-xs px-2.5 py-1 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 font-mono transition-colors flex items-center gap-1.5 cursor-pointer" 
                title="Lock Console" 
                @onclick="HandleLockAsync">
            <span>Lock</span>
            <span class="text-xs">⏻</span>
        </button>
    </div>
</header>
